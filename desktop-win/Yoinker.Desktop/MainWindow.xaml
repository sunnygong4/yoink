<Window x:Class="Yoinker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Yoinker Desktop"
        Width="1500"
        Height="920"
        MinWidth="1200"
        MinHeight="760"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Brush.Window" Color="#081512" />
        <SolidColorBrush x:Key="Brush.Sidebar" Color="#0C1613" />
        <SolidColorBrush x:Key="Brush.Panel" Color="#101917" />
        <SolidColorBrush x:Key="Brush.Card" Color="#121D1A" />
        <SolidColorBrush x:Key="Brush.Border" Color="#263A35" />
        <SolidColorBrush x:Key="Brush.BorderStrong" Color="#20312D" />
        <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F3F8F6" />
        <SolidColorBrush x:Key="Brush.TextSecondary" Color="#98B0A7" />
        <SolidColorBrush x:Key="Brush.Accent" Color="#74E0B6" />
        <SolidColorBrush x:Key="Brush.AccentText" Color="#08110D" />
        <SolidColorBrush x:Key="Brush.Input" Color="#162320" />
        <SolidColorBrush x:Key="Brush.NavButton" Color="#162320" />
        <SolidColorBrush x:Key="Brush.SecondaryButton" Color="#162320" />
        <SolidColorBrush x:Key="Brush.Player" Color="#0D1714" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Background" Value="{DynamicResource Brush.NavButton}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="{DynamicResource Brush.SecondaryButton}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldStyle" TargetType="Control">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Brush.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="104" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.BorderStrong}"
                BorderThickness="0,0,1,0"
                Padding="18,22">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="YOINKER"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="desktop prototype"
                               Margin="0,8,0,22"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Home" Content="Home" Click="SectionButton_Click" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Library" Content="Library" Click="SectionButton_Click" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Albums" Content="Albums" Click="SectionButton_Click" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Downloads" Content="Downloads" Click="SectionButton_Click" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="YB" Content="Y / B" Click="SectionButton_Click" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Settings" Content="Settings" Click="SectionButton_Click" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom"
                        Margin="0,18,0,0"
                        Padding="14"
                        Background="{DynamicResource Brush.Panel}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" FontSize="13" />
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24,22,18,14">
            <ScrollViewer x:Name="HomeSection">
                <StackPanel>
                    <TextBlock Text="Search and add real music to your server" FontSize="32" FontWeight="Bold" />
                    <WrapPanel Margin="0,16,0,16">
                        <ComboBox x:Name="CatalogSearchTypeCombo" Width="110" SelectedIndex="0" Style="{StaticResource FieldStyle}">
                            <ComboBoxItem Content="song" />
                            <ComboBoxItem Content="album" />
                            <ComboBoxItem Content="artist" />
                        </ComboBox>
                        <ComboBox x:Name="CatalogSourceCombo" Width="130" SelectedIndex="0" Style="{StaticResource FieldStyle}">
                            <ComboBoxItem Content="youtube" />
                            <ComboBoxItem Content="soundcloud" />
                            <ComboBoxItem Content="bilibili" />
                        </ComboBox>
                        <TextBox x:Name="CatalogQueryTextBox" Width="320" Style="{StaticResource FieldStyle}" Text="Mozart requiem" />
                        <TextBox x:Name="CatalogSecondaryQueryTextBox" Width="220" Style="{StaticResource FieldStyle}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Search" Click="HomeSearch_Click" />
                    </WrapPanel>
                    <ListBox ItemsSource="{Binding HomeResults}" Background="{DynamicResource Brush.Panel}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="14" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Height="96" Background="{DynamicResource Brush.Panel}" CornerRadius="14" ClipToBounds="True">
                                            <Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0" Text="{Binding ArtistLine}" Foreground="{DynamicResource Brush.TextPrimary}" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding MetaLine}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button Style="{StaticResource PrimaryButtonStyle}" Tag="{Binding}" Content="Preview" Click="HomePreview_Click" IsEnabled="{Binding CanPreview}" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Content="{Binding ImportLabel}" Click="HomeImport_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="LibrarySection" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Left" Text="Server library" FontSize="32" FontWeight="Bold" />
                        <WrapPanel DockPanel.Dock="Right">
                            <TextBox x:Name="LibraryFilterTextBox" Width="220" Style="{StaticResource FieldStyle}" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" Click="LibraryRefresh_Click" />
                        </WrapPanel>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding LibraryItems}" Background="{DynamicResource Brush.Panel}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="14" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Height="96" Background="{DynamicResource Brush.Panel}" CornerRadius="14" ClipToBounds="True">
                                            <Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0" Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding LocalStateLabel}" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" />
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button Style="{StaticResource PrimaryButtonStyle}" Tag="{Binding}" Content="Play" Click="LibraryPlay_Click" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Content="Queue" Click="LibraryQueue_Click" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Content="Download on this PC" Click="LibraryDownload_Click" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Content="Delete" Click="LibraryDelete_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AlbumsSection" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Left" Text="Albums on your server" FontSize="32" FontWeight="Bold" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" Click="AlbumsRefresh_Click" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding AlbumItems}" Background="{DynamicResource Brush.Panel}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="14" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Height="112" Background="{DynamicResource Brush.Panel}" CornerRadius="14" ClipToBounds="True">
                                            <Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0" Text="{Binding Artist}" Foreground="{DynamicResource Brush.TextPrimary}" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding MetaLine}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding LocalStateLabel}" Foreground="{DynamicResource Brush.Accent}" />
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button Style="{StaticResource PrimaryButtonStyle}" Tag="{Binding}" Content="Play Album" Click="AlbumPlay_Click" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Content="Save Album on this PC" Click="AlbumDownload_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DownloadsSection" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Left" Text="Offline music on this PC" FontSize="32" FontWeight="Bold" />
                        <WrapPanel DockPanel.Dock="Right">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Open Folder" Click="OpenDownloadsFolder_Click" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" Click="DownloadsRefresh_Click" />
                        </WrapPanel>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding OfflineItems}" Background="{DynamicResource Brush.Panel}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="14" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Height="96" Background="{DynamicResource Brush.Panel}" CornerRadius="14" ClipToBounds="True">
                                            <Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" />
                                            <TextBlock Margin="0,6,0,0" Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.TextPrimary}" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding DownloadedLabel}" Foreground="{DynamicResource Brush.Accent}" />
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button Style="{StaticResource PrimaryButtonStyle}" Tag="{Binding}" Content="Play Local" Click="OfflinePlay_Click" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Content="Open File" Click="OfflineOpenFile_Click" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Content="Remove" Click="OfflineRemove_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="YBSection" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Manual YouTube / SoundCloud / Bilibili tools" FontSize="32" FontWeight="Bold" />
                    <WrapPanel Margin="0,16,0,16">
                        <ComboBox x:Name="DiscoverySourceCombo" Width="130" SelectedIndex="0" Style="{StaticResource FieldStyle}">
                            <ComboBoxItem Content="youtube" />
                            <ComboBoxItem Content="soundcloud" />
                            <ComboBoxItem Content="bilibili" />
                        </ComboBox>
                        <ComboBox x:Name="DiscoveryTypeCombo" Width="110" SelectedIndex="0" Style="{StaticResource FieldStyle}">
                            <ComboBoxItem Content="song" />
                            <ComboBoxItem Content="album" />
                            <ComboBoxItem Content="artist" />
                        </ComboBox>
                        <TextBox x:Name="DiscoveryQueryTextBox" Width="320" Style="{StaticResource FieldStyle}" Text="Mozart requiem" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Search" Click="DiscoverySearch_Click" />
                    </WrapPanel>
                    <ListBox ItemsSource="{Binding DiscoveryItems}" Background="{DynamicResource Brush.Panel}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="14" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Height="96" Background="{DynamicResource Brush.Panel}" CornerRadius="14" ClipToBounds="True">
                                            <Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" />
                                            <TextBlock Margin="0,6,0,0" Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding SourceLabel}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button Style="{StaticResource PrimaryButtonStyle}" Tag="{Binding}" Content="Preview" Click="DiscoveryPreview_Click" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Content="Add to Library" Click="DiscoveryImport_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Margin="0,10,0,0" Padding="16" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="18">
                        <StackPanel>
                            <TextBlock Text="Direct URL import" FontSize="20" FontWeight="Bold" />
                            <WrapPanel Margin="0,12,0,0">
                                <TextBox x:Name="UrlImportTextBox" Width="360" Style="{StaticResource FieldStyle}" />
                                <ComboBox x:Name="UrlModeCombo" Width="100" SelectedIndex="0" Style="{StaticResource FieldStyle}">
                                    <ComboBoxItem Content="audio" />
                                    <ComboBoxItem Content="video" />
                                </ComboBox>
                                <CheckBox x:Name="AllowPlaylistCheckBox" Margin="0,8,10,0" VerticalAlignment="Center" Content="Import playlist / album" />
                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Send to Server" Click="UrlImport_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsSection" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Connect this app to your Yoinker server"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               FontSize="32"
                               FontWeight="Bold" />
                    <TextBlock Margin="0,16,0,6" Text="Theme" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <ComboBox x:Name="ThemePresetCombo"
                              Width="180"
                              Margin="0,0,0,10"
                              Style="{StaticResource FieldStyle}"
                              SelectionChanged="ThemePresetCombo_SelectionChanged">
                        <ComboBoxItem Content="classic" />
                        <ComboBoxItem Content="dark" />
                        <ComboBoxItem Content="bright" />
                    </ComboBox>
                    <TextBlock Margin="0,16,0,6" Text="Server URL" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBox x:Name="ServerUrlTextBox" Style="{StaticResource FieldStyle}" Text="http://127.0.0.1:8000" />
                    <TextBlock Margin="0,10,0,6" Text="Username" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBox x:Name="UsernameTextBox" Style="{StaticResource FieldStyle}" />
                    <TextBlock Margin="0,10,0,6" Text="Password" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <PasswordBox x:Name="PasswordBox"
                                 Margin="0,0,0,10"
                                 Padding="10,8"
                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                 Background="{DynamicResource Brush.Input}"
                                 BorderBrush="{DynamicResource Brush.Border}"
                                 BorderThickness="1" />
                    <TextBlock Margin="0,10,0,6" Text="Offline download folder" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBox x:Name="DownloadRootTextBox" Style="{StaticResource FieldStyle}" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Connect" Click="Connect_Click" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Save Settings" Click="SaveSettings_Click" />
                    </WrapPanel>
                    <TextBlock Margin="0,24,0,8"
                               Text="Legacy tools"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Launch the classic Python desktop app for fallback workflows."
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               TextWrapping="Wrap" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Launch Classic Yoinker" Click="LaunchLegacy_Click" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Open Project Folder" Click="OpenProjectFolder_Click" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="2" Margin="0,22,22,14" Padding="16" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Imports" FontSize="22" FontWeight="Bold" />
                    <Button Margin="0,10,0,14" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh Jobs" Click="JobsRefresh_Click" />
                </StackPanel>
                <StackPanel>
                    <ListBox ItemsSource="{Binding JobItems}" Height="320" Background="{DynamicResource Brush.Panel}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="12" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold" />
                                        <TextBlock Margin="0,6,0,0" Text="{Binding Title}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0" Text="{Binding Detail}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="0,18,0,10" Text="Queue" FontSize="22" FontWeight="Bold" />
                    <ListBox ItemsSource="{Binding PlaybackQueue}" Background="{DynamicResource Brush.Panel}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="12" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource Brush.Player}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="72" Height="72" Background="{DynamicResource Brush.Panel}" CornerRadius="16" ClipToBounds="True">
                        <Image Source="{Binding CurrentArtworkUrl}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NowPlayingTitle}" FontSize="18" FontWeight="Bold" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding NowPlayingSubtitle}" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Prev" Click="PlayerPrev_Click" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="{Binding PlayPauseLabel}" Click="PlayerPlayPause_Click" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Next" Click="PlayerNext_Click" />
                    </WrapPanel>
                    <Grid Width="520">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding PlayerElapsedLabel}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <Slider x:Name="PlayerPositionSlider"
                                Grid.Column="1"
                                Margin="10,0"
                                Minimum="0"
                                Maximum="1"
                                ValueChanged="PlayerPositionSlider_ValueChanged"
                                PreviewMouseLeftButtonDown="PlayerPositionSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="PlayerPositionSlider_PreviewMouseLeftButtonUp" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PlayerDurationLabel}" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Volume" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <Slider x:Name="VolumeSlider" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="75" ValueChanged="VolumeSlider_ValueChanged" />
                </StackPanel>
                <MediaElement x:Name="PlayerElement"
                              Visibility="Collapsed"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Manual"
                              MediaOpened="PlayerElement_MediaOpened"
                              MediaEnded="PlayerElement_MediaEnded"
                              MediaFailed="PlayerElement_MediaFailed" />
            </Grid>
        </Border>
    </Grid>
</Window>

