<Window x:Class="Yoinker.Desktop.VersionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Version"
        Width="760"
        Height="560"
        MinWidth="640"
        MinHeight="480"
        Background="#0F1316"
        Foreground="#F3F8F6"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Choose the version to add"
                       FontSize="26"
                       FontWeight="Bold" />
            <TextBlock Margin="0,8,0,0"
                       Text="{Binding HeaderText}"
                       Foreground="#A7B6B0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ListBox x:Name="VersionsListBox"
                 Grid.Row="1"
                 Margin="0,18,0,18"
                 Background="#11181B"
                 BorderBrush="#2A3438"
                 BorderThickness="1"
                 ItemsSource="{Binding Options}"
                 SelectedItem="{Binding SelectedOption}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="8"
                            Padding="12"
                            Background="#162026"
                            BorderBrush="#2F4048"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding ArtistLine}"
                                       Foreground="#D8E4DE"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding MetaLine}"
                                       Foreground="#8AA096"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding BadgeText}"
                                       Foreground="#74E0B6"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="120"
                    Height="42"
                    Margin="0,0,10,0"
                    Content="Cancel"
                    Click="Cancel_Click" />
            <Button Width="160"
                    Height="42"
                    Content="Add Selected"
                    Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
